<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mission Control | PropSurat{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        theme: { extend: { colors: {
            navy: '#0C1E35', 'navy-mid': '#1B3A5C',
            orange: '#E8621A', 'orange-light': '#F47B35',
            gold: '#D4922A', cream: '#F6F1EA', muted: '#64748B', green: '#1B7A42',
            control: '#1E1B4B',
        }, fontFamily: { outfit: ['Outfit','sans-serif'] } } }
    }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1/src/index.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        h1,h2,h3,.font-outfit { font-family: 'Outfit', sans-serif; }
        .mc-sidebar { background: #0F0A2E; width: 260px; min-height: 100vh; position: fixed; left: 0; top: 0; z-index: 50; transition: transform 0.3s; border-right: 1px solid rgba(255,255,255,0.06); }
        .mc-sidebar-link { display: flex; align-items: center; gap: 12px; padding: 10px 18px; border-radius: 10px; color: rgba(255,255,255,0.55); font-size: 13.5px; font-weight: 500; transition: all 0.18s; cursor: pointer; margin: 1px 6px; }
        .mc-sidebar-link:hover { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.9); }
        .mc-sidebar-link.active { background: #E8621A; color: white; }
        .mc-sidebar-section { font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.25); text-transform: uppercase; letter-spacing: 0.1em; padding: 14px 24px 4px; }
        .mc-main { margin-left: 260px; min-height: 100vh; background: #f1f5f9; }
        .mc-topbar { background: white; border-bottom: 1px solid #e2e8f0; padding: 0 28px; height: 64px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 40; }
        .mc-card { background: white; border-radius: 16px; padding: 22px 24px; border: 1px solid #e2e8f0; }
        .mc-stat { background: white; border-radius: 16px; padding: 20px 22px; border: 1px solid #e2e8f0; }
        .mc-stat-dark { background: linear-gradient(135deg, #0F0A2E 0%, #1E1B4B 100%); border-radius: 16px; padding: 20px 22px; border: 1px solid rgba(255,255,255,0.08); }
        .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.18s; border: none; }
        .btn-primary { background: #E8621A; color: white; }
        .btn-primary:hover { background: #c95516; }
        .btn-outline { background: white; color: #374151; border: 1.5px solid #e2e8f0; }
        .btn-outline:hover { border-color: #cbd5e1; background: #f8fafc; }
        .btn-green { background: #1B7A42; color: white; }
        .btn-green:hover { background: #155f34; }
        .btn-red { background: #dc2626; color: white; }
        .btn-red:hover { background: #b91c1c; }
        .btn-purple { background: #7c3aed; color: white; }
        .btn-purple:hover { background: #6d28d9; }
        .badge { display: inline-flex; align-items: center; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
        .mc-input { width: 100%; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 9px 14px; font-size: 14px; outline: none; transition: border-color 0.2s; }
        .mc-input:focus { border-color: #E8621A; box-shadow: 0 0 0 3px rgba(232,98,26,0.1); }
        .mc-mobile-btn { display: none; }
        @media (max-width: 1024px) {
            .mc-sidebar { transform: translateX(-100%); }
            .mc-sidebar.open { transform: translateX(0); }
            .mc-main { margin-left: 0; }
            .mc-mobile-btn { display: flex; }
        }
        {% block extra_styles %}{% endblock %}
    </style>
</head>
<body class="bg-slate-100" {% block body_attrs %}x-data="{ sidebarOpen: false }"{% endblock %}>

<!-- Impersonation banner -->
{% if request.session.get('impersonator_id') %}
<div class="bg-purple-700 text-white text-sm flex items-center justify-center gap-4 py-2 px-4">
    <i class="ph-bold ph-user-switch"></i>
    Impersonating: <strong>{{ request.user.full_name }}</strong>
    <form method="post" action="{{ url('control:stop_impersonate') }}" class="inline">
        {{ csrf_input }}
        <button type="submit" class="bg-white text-purple-700 text-xs font-bold px-3 py-1 rounded-full hover:bg-purple-50 ml-2">
            Stop
        </button>
    </form>
</div>
{% endif %}

<!-- Sidebar -->
<div class="mc-sidebar" :class="sidebarOpen ? 'open' : ''">
    <div class="px-5 py-5 border-b border-white/8">
        <a href="{{ url('control:dashboard') }}" class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-orange rounded-lg flex items-center justify-center">
                <i class="ph-bold ph-shield-check text-white text-base"></i>
            </div>
            <div>
                <div class="font-outfit font-bold text-base text-white leading-none">PropSurat</div>
                <div class="text-xs text-purple-300 font-medium">Mission Control</div>
            </div>
        </a>
    </div>

    <div class="px-4 py-3 border-b border-white/8">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-orange/20 border border-orange/30 flex items-center justify-center font-outfit font-bold text-orange text-sm">
                {{ request.user.full_name[0] }}
            </div>
            <div>
                <div class="text-white text-xs font-semibold">{{ request.user.full_name }}</div>
                <div class="text-purple-300/70 text-xs">Global Admin</div>
            </div>
        </div>
    </div>

    <nav class="px-3 py-3">
        <div class="mc-sidebar-section">Overview</div>
        <a href="{{ url('control:dashboard') }}"
           class="mc-sidebar-link {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}">
            <i class="ph-bold ph-squares-four"></i> Dashboard
        </a>

        <div class="mc-sidebar-section">Management</div>
        <a href="{{ url('control:users') }}"
           class="mc-sidebar-link {% if request.resolver_match.url_name == 'users' %}active{% endif %}">
            <i class="ph-bold ph-users-three"></i> User Manager
        </a>
        <a href="{{ url('dashboard_admin') }}"
           class="mc-sidebar-link">
            <i class="ph-bold ph-city"></i> City Admin Panel
        </a>
        <a href="{{ url('listings') }}"
           class="mc-sidebar-link">
            <i class="ph-bold ph-buildings"></i> All Listings
        </a>

        <div class="mc-sidebar-section">Platform</div>
        <a href="{{ url('home') }}" class="mc-sidebar-link" target="_blank">
            <i class="ph-bold ph-arrow-square-out"></i> View Site
        </a>
        <div class="mt-3 pt-3 border-t border-white/8">
            <form method="post" action="{{ url('logout') }}">
                {{ csrf_input }}
                <button type="submit" class="mc-sidebar-link w-full text-red-400 hover:text-red-300 hover:bg-red-500/10">
                    <i class="ph-bold ph-sign-out"></i> Logout
                </button>
            </form>
        </div>
    </nav>
</div>

<!-- Main -->
<div class="mc-main">
    <!-- Topbar -->
    <div class="mc-topbar">
        <div class="flex items-center gap-4">
            <button class="mc-mobile-btn items-center justify-center w-9 h-9 rounded-lg hover:bg-slate-100"
                    @click="sidebarOpen=!sidebarOpen">
                <i class="ph-bold ph-list text-slate-700 text-xl"></i>
            </button>
            <div>
                <h1 class="font-outfit font-bold text-navy text-lg">{% block page_title %}Mission Control{% endblock %}</h1>
                <p class="text-muted text-xs hidden sm:block">PropSurat Mission Control</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div class="hidden sm:flex items-center gap-2 bg-purple-50 border border-purple-200 rounded-xl px-3 py-1.5">
                <i class="ph-bold ph-shield-check text-purple-600 text-sm"></i>
                <span class="text-purple-700 text-xs font-semibold">Global Admin</span>
            </div>
        </div>
    </div>

    <div class="p-6 md:p-8">
        {% block content %}{% endblock %}
    </div>
</div>

{% block extra_js %}{% endblock %}
<script>
    document.addEventListener('htmx:configRequest', function(e) {
        var match = document.cookie.match(/csrftoken=([^;]+)/);
        if (match) e.detail.headers['X-CSRFToken'] = match[1];
    });
</script>
</body>
</html>
