                        <button class="text-orange font-medium whitespace-nowrap">All India</button>
                        <button class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">West India</button>
                        <button class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">North India</button>
                        <button class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">South India</button>
                    </div>
                    <div class="flex flex-col gap-2 pointer-events-auto">
                        <button
