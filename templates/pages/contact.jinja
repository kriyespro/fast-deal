{% extends 'base.jinja' %}

{% block title %}Contact Us | PropSurat{% endblock %}
{% block extra_head %}
<style>
}
</style>
{% endblock %}


{% block content %}
    <!-- Header Section -->
    <div class="pt-16 pb-16 bg-slate-50 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-10">
        </div>
        <div
            class="absolute top-1/2 left-1/2 w-full max-w-4xl h-96 bg-navy/10 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 pointer-events-none">
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 font-outfit mb-6">Let's <span
                    class="text-gradient">Connect</span></h1>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
                Ghar khareedna hai, rent dhundna hai, ya apni property list karni hai? Hamari team 24x7 aapki help ke liye ready hai.
            </p>
        </div>
    </div>

    <!-- Contact Section -->
    <section class="py-12 pb-24 bg-white border-t border-slate-200 relative z-20 flex-grow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24">

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <!-- Contact Info Cards -->
                <div class="lg:col-span-1 space-y-6">
                    <!-- HQ Office -->
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-2xl relative overflow-hidden group hover:border-slate-300 transition-colors">
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-navy/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none">
                        </div>
                        <i class="ph-fill ph-buildings text-4xl text-orange mb-6"></i>
                        <h3 class="text-xl font-bold text-slate-900 font-outfit mb-4">Head Office — Surat</h3>
                        <p class="text-slate-500 mb-2 leading-relaxed">Plot 401, Vesu Ring Road<br>Vesu, Surat, Gujarat 395007</p>
                        <a href="#"
                            class="inline-flex items-center gap-2 text-orange hover:text-slate-900 transition-colors text-sm font-medium mt-4">
                            Get Directions <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>

                    <!-- Direct Contact -->
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-2xl relative overflow-hidden group hover:border-slate-300 transition-colors">
                        <i class="ph-fill ph-phone-call text-4xl text-orange mb-6"></i>
                        <h3 class="text-xl font-bold text-slate-900 font-outfit mb-4">Direct Contact</h3>
                        <div class="space-y-4">
                            <div>
                                <div class="text-sm text-slate-400 mb-1">Naya Inquiry</div>
                                <a href="tel:+13105550198"
                                    class="text-lg text-slate-900 hover:text-orange transition-colors">+91 98765 43210</a>
                            </div>
                            <div>
                                <div class="text-sm text-slate-400 mb-1">General Support</div>
                                <a href="mailto:hello@propsurat.com"
                                    class="text-lg text-slate-900 hover:text-orange transition-colors break-all">hello@propsurat.com</a>
                            </div>
                        </div>
                    </div>

                    <!-- Socials -->
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-2xl">
                        <h3 class="text-xl font-bold text-slate-900 font-outfit mb-6">Follow Us</h3>
                        <div class="flex gap-4">
                            <a href="#"
                                class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-gray-400 hover:text-white hover:bg-orange transition-colors shadow-lg">
                                <i class="ph-fill ph-facebook-logo text-xl"></i>
                            </a>
                            <a href="#"
                                class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-gradient-to-tr hover:from-yellow-400 hover:via-red-500 hover:to-purple-500 transition-colors shadow-lg">
                                <i class="ph-fill ph-instagram-logo text-xl"></i>
                            </a>
                            <a href="#"
                                class="w-12 h-12 rounded-full bg-white border border-slate-200 flex items-center justify-center text-gray-400 hover:text-white hover:bg-blue-800 transition-colors shadow-lg">
                                <i class="ph-fill ph-linkedin-logo text-xl"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="lg:col-span-2">
                    <div
                        class="bg-slate-50 border border-slate-200 rounded-2xl p-8 md:p-12 shadow-2xl h-full relative overflow-hidden">
                        <div
                            class="absolute bottom-0 left-0 w-64 h-64 bg-navy/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none">
                        </div>

                        <h2 class="text-3xl font-bold text-slate-900 font-outfit mb-2">Send an Inquiry</h2>
                        <p class="text-slate-500 mb-8">Please detail your requirements below, and a specialized advisor
                            will contact you within 24 hours.</p>

                        <!-- Alpine Form State Handling -->
                        <form
                            @submit.prevent="formStatus = 'submitting'; setTimeout(() => formStatus = 'success', 1500)"
                            x-show="formStatus !== 'success'" class="space-y-6 relative z-10">

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-slate-500 mb-2">First Name</label>
                                    <input type="text" required
                                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-500 mb-2">Last Name</label>
                                    <input type="text" required
                                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-slate-500 mb-2">Email Address</label>
                                    <input type="email" required
                                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-500 mb-2">Phone Number</label>
                                    <input type="tel"
                                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">I am interested
                                    in...</label>
                                <select
                                    class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange appearance-none custom-select relative">
                                    <option value="" disabled selected>Please select an option</option>
                                    <option value="buying">Purchasing a Property</option>
                                    <option value="selling">Selling a Property</option>
                                    <option value="leasing">Leasing / Renting</option>
                                    <option value="other">General Inquiry</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-500 mb-2">Message</label>
                                <textarea rows="5" required
                                    class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:border-orange transition-colors focus:ring-1 focus:ring-orange resize-none"
                                    placeholder="Provide any specific details about locations, budgets, or properties of interest..."></textarea>
                            </div>

                            <button type="submit" :disabled="formStatus === 'submitting'"
                                class="w-full md:w-auto bg-orange hover:bg-orange-700 text-white font-bold rounded-lg px-10 py-4 transition-all shadow-lg shadow-orange/20 flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed">
                                <span x-show="formStatus !== 'submitting'">Send Inquiry</span>
                                <span x-show="formStatus === 'submitting'">Sending...</span>
                                <i x-show="formStatus !== 'submitting'" class="ph-bold ph-paper-plane-tilt"></i>
                                <i x-show="formStatus === 'submitting'" class="ph-bold ph-spinner animate-spin"></i>
                            </button>
                        </form>

                        <!-- Success State -->
                        <div x-show="formStatus === 'success'" style="display: none;"
                            class="h-full flex flex-col items-center justify-center text-center py-16 relative z-10 animate-fade-in-up">
                            <div
                                class="w-20 h-20 bg-green-500/20 text-green-500 rounded-full flex items-center justify-center mb-6">
                                <i class="ph-fill ph-check-circle text-5xl"></i>
                            </div>
                            <h3 class="text-3xl font-bold text-slate-900 font-outfit mb-4">Inquiry Received</h3>
                            <p class="text-slate-500 max-w-md mx-auto mb-8">
                                Thank you for reaching out. A PropSurat advisor has been assigned to your request and
                                will contact you via email shortly.
                            </p>
                            <button @click="formStatus = 'idle'"
                                class="bg-white hover:bg-slate-100 border border-slate-200 text-slate-900 font-medium px-8 py-3 rounded-lg transition-colors">
                                Send Another Message
                            </button>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Map Placeholder -->
            <div
                class="w-full h-[400px] bg-slate-50 border border-slate-200 rounded-2xl mt-12 overflow-hidden relative shadow-2xl flex items-center justify-center group cursor-pointer">
                <!-- Fallback background if API fails or isn't loaded -->
                <div
                    class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1524661135-423995f22d0b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80')] bg-cover bg-center opacity-40 grayscale group-hover:grayscale-0 transition-all duration-700">
                </div>
                <!-- Interactive hint -->
                <div
                    class="relative z-10 bg-white/90 backdrop-blur-md px-6 py-3 rounded-full border border-slate-200 text-slate-900 font-medium flex items-center gap-2 group-hover:bg-orange/90 group-hover:border-orange group-hover:text-white transition-colors">
                    <i class="ph ph-map-pin text-xl"></i> Open Interactive Map
                </div>
            </div>

        </div>
    </section>

{% endblock %}
