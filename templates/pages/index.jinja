{% extends 'base.jinja' %}

{% block body_attrs %}x-data="{ mobileMenu: false, scrolled: false, activeTab: 'buy' }" @scroll.window="scrolled = window.pageYOffset > 40"{% endblock %}

{% block title %}PropSurat – Apna Ghar Dhundo | Surat Property Portal{% endblock %}
{% block extra_head %}
<style>
.card-hover { transition: all .3s cubic-bezier(.4,0,.2,1); }
        .card-hover:hover { transform: translateY(-6px); box-shadow: 0 20px 40px -10px rgba(12,30,53,.15); }
        .hero-overlay { background: linear-gradient(135deg, rgba(12,30,53,.92) 0%, rgba(12,30,53,.7) 50%, rgba(12,30,53,.2) 100%); }
        .search-glass { background: rgba(255,255,255,.97); backdrop-filter: blur(20px); }
        .rera-badge { background: linear-gradient(135deg, #1B7A42, #27AE60); }
        .verified-badge { background: linear-gradient(135deg, #1B3A5C, #2563EB); }
        .ticker-wrap { overflow: hidden; white-space: nowrap; }
        .ticker-content { display: inline-block; animation: ticker 30s linear infinite; }
        @keyframes ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
        .city-card:hover img { transform: scale(1.08); }
        .city-card img { transition: transform .5s ease; }
        .city-overlay { background: linear-gradient(to top, rgba(12,30,53,.85) 0%, rgba(12,30,53,.2) 60%, transparent 100%); }
        .prop-tag-rent { background: rgba(27,122,66,.15); color: #1B7A42; border: 1px solid rgba(27,122,66,.3); }
        .prop-tag-sale { background: rgba(232,98,26,.12); color: #C4500F; border: 1px solid rgba(232,98,26,.25); }
        .prop-tag-new { background: rgba(37,99,235,.12); color: #1D4ED8; border: 1px solid rgba(37,99,235,.25); }
        .testimonial-card { background: linear-gradient(135deg, #fff 0%, #fef9f6 100%); }
</style>
{% endblock %}

{% block nav %}
<nav :class="scrolled ? 'bg-white/98 shadow-lg backdrop-blur-md' : 'bg-transparent'"
     class="fixed w-full z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <a href="{{ url('home') }}" class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-orange flex items-center justify-center shadow-md">
                    <i class="ph-fill ph-house-line text-white text-xl"></i>
                </div>
                <div>
                    <span class="font-outfit text-xl font-800 leading-none" :class="scrolled ? 'text-navy' : 'text-white'">Prop<span class="text-orange">Surat</span></span>
                    <div class="text-[9px] font-semibold tracking-[.15em] uppercase" :class="scrolled ? 'text-muted' : 'text-white/70'">Surat Property Portal</div>
                </div>
            </a>
            <div class="hidden lg:flex items-center gap-6">
                <a href="{{ url('listings') }}" class="text-sm font-medium transition-colors" :class="scrolled ? 'text-slate-600 hover:text-orange' : 'text-white/90 hover:text-orange'">Buy</a>
                <a href="{{ url('listings') }}" class="text-sm font-medium transition-colors" :class="scrolled ? 'text-slate-600 hover:text-orange' : 'text-white/90 hover:text-orange'">Rent</a>
                <a href="{{ url('neighborhoods') }}" class="text-sm font-medium transition-colors" :class="scrolled ? 'text-slate-600 hover:text-orange' : 'text-white/90 hover:text-orange'">Localities</a>
                <a href="{{ url('agents') }}" class="text-sm font-medium transition-colors" :class="scrolled ? 'text-slate-600 hover:text-orange' : 'text-white/90 hover:text-orange'">Brokers</a>
                <a href="{{ url('about') }}" class="text-sm font-medium transition-colors" :class="scrolled ? 'text-slate-600 hover:text-orange' : 'text-white/90 hover:text-orange'">About</a>
            </div>
            <div class="hidden lg:flex items-center gap-3">
                {% if request.user.is_authenticated %}
                    <span class="text-sm font-medium" :class="scrolled ? 'text-navy' : 'text-white/80'">{{ request.user.full_name }}</span>
                    <form method="post" action="{{ url('logout') }}" class="inline">{{ csrf_input }}
                        <button type="submit" class="text-sm font-semibold px-4 py-2 rounded-lg transition-colors" :class="scrolled ? 'text-navy hover:bg-slate-100' : 'text-white hover:bg-white/10'">Logout</button>
                    </form>
                {% else %}
                    <a href="{{ url('login') }}" class="text-sm font-semibold px-4 py-2 rounded-lg transition-colors" :class="scrolled ? 'text-navy hover:bg-slate-100' : 'text-white hover:bg-white/10'">Login</a>
                    <a href="{{ url('register') }}" class="text-sm font-semibold px-4 py-2 rounded-lg border transition-colors" :class="scrolled ? 'border-orange text-orange hover:bg-orange hover:text-white' : 'border-white/50 text-white hover:bg-white hover:text-navy'">Register</a>
                    <a href="{{ url('register') }}" class="btn-primary text-sm font-bold px-5 py-2.5 rounded-xl flex items-center gap-1.5">
                        <i class="ph-bold ph-plus-circle"></i> List Property
                    </a>
                {% endif %}
            </div>
            <button @click="mobileMenu = !mobileMenu" class="lg:hidden p-2 rounded-lg" :class="scrolled ? 'text-navy' : 'text-white'">
                <i class="ph text-2xl" :class="mobileMenu ? 'ph-x' : 'ph-list'"></i>
            </button>
        </div>
    </div>
    <div x-show="mobileMenu" x-transition class="lg:hidden bg-white border-t border-slate-100 shadow-xl">
        <div class="px-4 py-4 space-y-1">
            <a href="{{ url('listings') }}" class="block py-3 px-4 rounded-lg text-slate-700 hover:bg-orange/5 hover:text-orange font-medium">Buy Property</a>
            <a href="{{ url('listings') }}" class="block py-3 px-4 rounded-lg text-slate-700 hover:bg-orange/5 hover:text-orange font-medium">Rent Property</a>
            <a href="{{ url('neighborhoods') }}" class="block py-3 px-4 rounded-lg text-slate-700 hover:bg-orange/5 hover:text-orange font-medium">Localities</a>
            <a href="{{ url('agents') }}" class="block py-3 px-4 rounded-lg text-slate-700 hover:bg-orange/5 hover:text-orange font-medium">Brokers</a>
            <a href="{{ url('about') }}" class="block py-3 px-4 rounded-lg text-slate-700 hover:bg-orange/5 hover:text-orange font-medium">About Us</a>
            <div class="flex gap-3 pt-3 border-t border-slate-100">
                <a href="{{ url('login') }}" class="flex-1 text-center py-2.5 border border-slate-300 rounded-xl text-navy font-semibold text-sm">Login</a>
                <a href="{{ url('register') }}" class="flex-1 text-center py-2.5 btn-primary rounded-xl font-semibold text-sm">Register</a>
            </div>
        </div>
    </div>
</nav>
{% endblock %}

{% block content %}
<!-- ═══════════════ HERO ═══════════════ -->
<div class="relative min-h-screen flex items-center" style="min-height: 680px;">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2000&q=85"
             alt="Beautiful Home" class="w-full h-full object-cover">
        <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 bg-orange/20 backdrop-blur-sm border border-orange/40 text-orange px-4 py-1.5 rounded-full text-sm font-semibold mb-5">
                <i class="ph-fill ph-seal-check"></i> RERA Verified Properties
            </div>
            <h1 class="font-outfit text-4xl sm:text-5xl md:text-6xl font-900 text-white leading-tight mb-4">
                Apna Ghar Dhundo<br/>
                <span class="text-gradient">Sahi Deal Ke Saath</span>
            </h1>
            <p class="text-white/80 text-lg md:text-xl mb-8 leading-relaxed max-w-2xl">
                Surat ka trusted property portal — Vesu se Adajan, Athwa se Pal. Verified listings, RERA brokers. Broker se milao, ghar dhundo!
            </p>

            <!-- Search Panel -->
            <div class="search-glass rounded-2xl shadow-2xl overflow-hidden border border-white/20">
                <!-- Tabs -->
                <div class="flex border-b border-slate-100 px-2 pt-2">
                    <button @click="activeTab='buy'" :class="activeTab==='buy' ? 'border-orange text-orange bg-orange/5' : 'border-transparent text-slate-500 hover:text-slate-700'"
