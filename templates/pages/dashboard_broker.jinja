{% extends 'layouts/dashboard_base.jinja' %}
{% block title %}Broker Dashboard | PropSurat{% endblock %}

{% block body_attrs %}x-data="{ activeTab: 'overview', sidebarOpen: false, showAddModal: false }"{% endblock %}

{% block body %}
<!-- Sidebar -->
<div class="sidebar" :class="sidebarOpen ? 'open' : ''">
    <div class="px-5 py-5 border-b border-white/10">
        <a href="{{ url('home') }}" class="flex items-center gap-2">
            <div class="w-8 h-8 bg-orange rounded-lg flex items-center justify-center">
                <i class="ph-bold ph-buildings text-white text-base"></i>
            </div>
            <span class="font-outfit font-bold text-xl text-white">Prop<span class="text-orange">Surat</span></span>
        </a>
    </div>
    <div class="px-5 py-4 border-b border-white/10">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-orange flex items-center justify-center font-outfit font-bold text-white text-lg">
                {{ request.user.full_name[0] }}
            </div>
            <div>
                <div class="text-white text-sm font-semibold">{{ request.user.full_name }}</div>
                <div class="flex items-center gap-1.5">
                    <div class="w-1.5 h-1.5 rounded-full bg-green-400"></div>
                    <span class="text-white/40 text-xs">RERA Certified Broker</span>
                </div>
            </div>
        </div>
    </div>
    <nav class="px-3 py-4 space-y-0.5">
        <div class="sidebar-link" :class="activeTab==='overview' ? 'active' : ''" @click="activeTab='overview'; sidebarOpen=false">
            <i class="ph-bold ph-squares-four"></i> Overview
        </div>
        <div class="sidebar-link" :class="activeTab==='listings' ? 'active' : ''" @click="activeTab='listings'; sidebarOpen=false">
            <i class="ph-bold ph-buildings"></i> My Listings
            <span class="ml-auto bg-orange/20 text-orange text-xs px-1.5 py-0.5 rounded-full font-semibold">{{ stats.total }}</span>
        </div>
        <div class="sidebar-link" :class="activeTab==='leads' ? 'active' : ''" @click="activeTab='leads'; sidebarOpen=false">
            <i class="ph-bold ph-users"></i> Leads
            {% if stats.unread_inquiries %}
            <span class="ml-auto bg-red-500/20 text-red-400 text-xs px-1.5 py-0.5 rounded-full font-semibold">{{ stats.unread_inquiries }} new</span>
            {% endif %}
        </div>
        <div class="sidebar-link" :class="activeTab==='profile' ? 'active' : ''" @click="activeTab='profile'; sidebarOpen=false">
            <i class="ph-bold ph-user-circle"></i> My Profile
        </div>
        <div class="mt-2 pt-2 border-t border-white/10">
            <a href="{{ url('billing_plans') }}" class="sidebar-link">
                <i class="ph-bold ph-credit-card"></i> Billing & Plans
                {% if not request.user.subscription or not request.user.subscription.is_active %}
                <span class="ml-auto bg-orange/20 text-orange text-xs px-1.5 py-0.5 rounded-full font-semibold">Free</span>
                {% endif %}
            </a>
        </div>
        <div class="mt-4 pt-4 border-t border-white/10">
            <form method="post" action="{{ url('logout') }}">
                {{ csrf_input }}
                <button type="submit" class="sidebar-link w-full text-left text-red-400 hover:text-red-300 hover:bg-red-500/10">
                    <i class="ph-bold ph-sign-out"></i> Logout
                </button>
            </form>
        </div>
    </nav>
</div>

<!-- Main -->
<div class="main">
    <div class="topbar">
        <div class="flex items-center gap-4">
            <button class="mobile-menu-btn items-center justify-center w-9 h-9 rounded-lg hover:bg-slate-100" @click="sidebarOpen=!sidebarOpen">
                <i class="ph-bold ph-list text-slate-700 text-xl"></i>
            </button>
            <div>
                <h1 class="font-outfit font-bold text-navy text-lg leading-tight">
                    <span x-text="activeTab==='overview' ? 'Broker Dashboard' : activeTab==='listings' ? 'My Listings' : activeTab==='leads' ? 'Leads' : 'My Profile'"></span>
                </h1>
                <p class="text-muted text-xs hidden sm:block">{{ request.user.full_name }} · May 2026</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ url('listings') }}" class="relative w-9 h-9 flex items-center justify-center rounded-lg hover:bg-slate-100" title="View listings">
                <i class="ph-bold ph-house text-slate-600 text-lg"></i>
            </a>
            <button @click="showAddModal=true" class="btn btn-orange">
                <i class="ph-bold ph-plus"></i>
                <span class="hidden sm:inline">Add Listing</span>
            </button>
        </div>
    </div>

    <div class="p-6 md:p-8">

        <!-- ── OVERVIEW ────────────────────────────────────── -->
        <div x-show="activeTab==='overview'" x-transition>
            <!-- Stats -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center"><i class="ph-fill ph-buildings text-blue-600 text-lg"></i></div>
                        <span class="text-xs text-green font-semibold">{{ stats.active }} active</span>
                    </div>
                    <div class="font-outfit text-3xl font-bold text-navy mt-3">{{ stats.total }}</div>
                    <div class="text-muted text-sm mt-1">Total Listings</div>
                    <div class="mini-bar"><div class="mini-bar-fill" style="width:{{ [stats.active * 100 // (stats.total or 1), 100] | min }}%"></div></div>
                </div>
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 bg-orange/10 rounded-xl flex items-center justify-center"><i class="ph-fill ph-users text-orange text-lg"></i></div>
                        {% if stats.unread_inquiries %}<span class="text-xs text-red-500 font-semibold">{{ stats.unread_inquiries }} new</span>{% endif %}
                    </div>
                    <div class="font-outfit text-3xl font-bold text-navy mt-3">{{ stats.total_inquiries }}</div>
                    <div class="text-muted text-sm mt-1">Total Leads</div>
                    <div class="mini-bar"><div class="mini-bar-fill" style="width:60%"></div></div>
                </div>
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center"><i class="ph-fill ph-clock text-amber-600 text-lg"></i></div>
                        <span class="text-xs text-amber-600 font-semibold">Pending review</span>
                    </div>
                    <div class="font-outfit text-3xl font-bold text-navy mt-3">{{ stats.pending }}</div>
                    <div class="text-muted text-sm mt-1">Pending Approval</div>
                    <div class="mini-bar"><div class="mini-bar-fill" style="width:{{ [stats.pending * 100 // (stats.total or 1), 100] | min }}%"></div></div>
                </div>
                <div class="stat-card">
                    <div class="flex items-center justify-between">
                        <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center"><i class="ph-fill ph-eye text-green-600 text-lg"></i></div>
                    </div>
                    <div class="font-outfit text-3xl font-bold text-navy mt-3">{{ stats.total_views }}</div>
                    <div class="text-muted text-sm mt-1">Total Views</div>
                    <div class="mini-bar"><div class="mini-bar-fill" style="width:75%"></div></div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Recent Leads -->
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                        <h2 class="font-outfit font-semibold text-navy">Latest Leads</h2>
                        <button @click="activeTab='leads'" class="text-orange text-sm font-medium hover:underline">Sab dekho →</button>
                    </div>
                    <div>
                        {% for inq in inquiries[:4] %}
                        <div class="lead-row gap-3">
                            <div class="w-9 h-9 rounded-full bg-navy/10 flex items-center justify-center font-outfit font-bold text-navy text-sm flex-shrink-0">
                                {{ inq.name[0] | upper }}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="font-medium text-navy text-sm">{{ inq.name }}</div>
                                <div class="text-xs text-muted truncate">{{ inq.property.title }}{% if inq.phone %} · {{ inq.phone }}{% endif %}</div>
                            </div>
                            <div class="text-right hidden md:block">
                                <div class="text-xs text-muted">{{ inq.created_at.strftime('%d %b') }}</div>
                            </div>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full flex-shrink-0 {% if not inq.is_read %}bg-red-100 text-red-700{% else %}bg-blue-100 text-blue-700{% endif %}">
                                {% if not inq.is_read %}● New{% else %}Seen{% endif %}
                            </span>
                            <a href="tel:{{ inq.phone }}" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center hover:bg-orange hover:text-white transition-colors flex-shrink-0">
                                <i class="ph-bold ph-phone text-xs"></i>
                            </a>
                        </div>
                        {% else %}
                        <div class="px-5 py-10 text-center text-muted text-sm">
                            <i class="ph-fill ph-users text-2xl block mb-2 text-slate-300"></i>
                            Abhi koi lead nahi hai
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Performance -->
                <div class="space-y-4">
                    <div class="stat-card">
                        <h3 class="font-outfit font-semibold text-navy mb-4">Listing Performance</h3>
                        <div class="space-y-3">
                            {% set max_views = properties | map(attribute='views_count') | max | default(1) %}
                            {% for prop in properties[:5] %}
                            <div>
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="text-slate-600 truncate">{{ prop.title | truncate(28, True) }}</span>
                                    <span class="text-muted ml-2">{{ prop.views_count }} views</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width:{{ [prop.views_count * 100 // (max_views or 1), 100] | min }}%"></div>
                                </div>
                            </div>
                            {% else %}
                            <p class="text-muted text-sm text-center py-4">Koi listing nahi</p>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="stat-card">
                        <h3 class="font-outfit font-semibold text-navy mb-3">RERA Status</h3>
                        <div class="flex items-center gap-3 p-3 bg-green-50 border border-green-200 rounded-xl">
                            <i class="ph-bold ph-seal-check text-green-600 text-xl"></i>
                            <div>
                                <div class="text-sm font-semibold text-green-800">Verified ✓</div>
                                <div class="text-xs text-green-600">
                                    {% if request.user.profile.rera_number %}{{ request.user.profile.rera_number }}{% else %}RERA Not Added{% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── LISTINGS ───────────────────────────────────── -->
        <div x-show="activeTab==='listings'" x-transition>
            <div class="flex items-center justify-between mb-5">
                <div class="flex gap-2 flex-wrap">
                    <span class="btn btn-outline text-sm py-2">All ({{ stats.total }})</span>
                    <span class="btn btn-outline text-sm py-2">Active ({{ stats.active }})</span>
                    <span class="btn btn-outline text-sm py-2">Pending ({{ stats.pending }})</span>
                </div>
                <button @click="showAddModal=true" class="btn btn-orange">
                    <i class="ph-bold ph-plus"></i> Add Listing
                </button>
            </div>

            {% if properties %}
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                {% for prop in properties %}
                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all">
                    <div class="relative">
                        {% set imgs = prop.prefetched_images if prop.prefetched_images is defined else [] %}
                        {% if imgs %}
                        <img src="{{ imgs[0].image.url }}" class="w-full h-40 object-cover" alt="{{ prop.title }}" loading="lazy" decoding="async">
                        {% else %}
                        <div class="w-full h-40 bg-gradient-to-br from-slate-200 to-slate-300 flex items-center justify-center">
                            <i class="ph-fill ph-buildings text-slate-400 text-3xl"></i>
                        </div>
                        {% endif %}
                        <span class="absolute top-3 left-3 tag
                            {% if prop.status == 'active' %}tag-active
                            {% elif prop.status == 'pending' %}tag-pending
                            {% elif prop.status == 'sold' %}bg-purple-100 text-purple-700
                            {% else %}tag-inactive{% endif %}">
                            {{ prop.get_status_display() }}
                        </span>
                        <div class="absolute top-3 right-3 flex gap-1.5">
                            {% if prop.status == 'active' %}
                            <a href="{{ url('property_detail', slug=prop.slug) }}" class="w-7 h-7 bg-white rounded-full flex items-center justify-center shadow hover:bg-blue-500 hover:text-white transition-colors" title="View Live">
                                <i class="ph-bold ph-eye text-xs"></i>
                            </a>
                            {% else %}
                            <span class="w-7 h-7 bg-white/60 rounded-full flex items-center justify-center shadow cursor-not-allowed" title="Not live yet">
                                <i class="ph-bold ph-eye text-xs text-slate-300"></i>
                            </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-outfit font-semibold text-navy text-sm leading-snug">{{ prop.title | truncate(40, True) }}</h3>
                        <p class="text-muted text-xs flex items-center gap-1 mt-0.5">
                            <i class="ph-bold ph-map-pin"></i>
                            {% if prop.locality %}{{ prop.locality.name }}, {% endif %}{{ prop.city.name if prop.city else '' }}
                        </p>
                        <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-100">
                            <div class="font-outfit font-bold text-navy text-lg">{{ prop.price_display }}</div>
                            <div class="flex items-center gap-3 text-xs text-muted">
                                <span class="flex items-center gap-1"><i class="ph-bold ph-eye"></i>{{ prop.views_count }}</span>
                                <span class="flex items-center gap-1"><i class="ph-bold ph-users"></i>{{ prop.lead_count if prop.lead_count is defined else prop.inquiries.count() }} leads</span>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-slate-100"
                             id="property-images-{{ prop.pk }}"
                             hx-get="{{ url('add_property_images', pk=prop.pk) }}"
                             hx-trigger="none">
                            {% with property=prop, images=prop.prefetched_images if prop.prefetched_images is defined else [] %}
                            {% include 'partials/_property_images.jinja' %}
                            {% endwith %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="text-center py-20 bg-white rounded-2xl border border-slate-200">
                <i class="ph-fill ph-buildings text-slate-300 text-5xl block mb-4"></i>
                <h3 class="font-outfit font-bold text-slate-700 text-xl mb-2">Koi listing nahi hai abhi</h3>
                <p class="text-muted mb-5">Pehli property add karo aur leads paao!</p>
                <button @click="showAddModal=true" class="btn btn-orange">
                    <i class="ph-bold ph-plus"></i> Add First Listing
                </button>
            </div>
            {% endif %}
        </div>

        <!-- ── LEADS ──────────────────────────────────────── -->
        <div x-show="activeTab==='leads'" x-transition>
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="font-outfit font-semibold text-navy">All Leads</h2>
                        <p class="text-xs text-muted mt-0.5">{{ stats.total_inquiries }} total · {{ stats.unread_inquiries }} new</p>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm min-w-[480px]">
                        <thead>
                            <tr class="border-b border-slate-100 bg-slate-50">
                                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide">Client</th>
                                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide hidden md:table-cell">Property</th>
                                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide">Status</th>
                                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide hidden md:table-cell">Date</th>
                                <th class="px-5 py-3.5">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for inq in inquiries %}
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-navy/10 flex items-center justify-center font-outfit font-bold text-navy text-xs flex-shrink-0">
                                            {{ inq.name[0] | upper }}
                                        </div>
                                        <div>
                                            <div class="font-medium text-navy">{{ inq.name }}</div>
                                            <div class="text-xs text-muted">{{ inq.phone }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4 text-muted hidden md:table-cell text-xs">{{ inq.property.title | truncate(35, True) }}</td>
                                <td class="px-5 py-4">
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full {% if not inq.is_read %}bg-red-100 text-red-700{% else %}bg-green-100 text-green-700{% endif %}">
                                        {% if not inq.is_read %}● New{% else %}Seen{% endif %}
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-xs text-muted hidden md:table-cell">{{ inq.created_at.strftime('%d %b %Y') }}</td>
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-2">
                                        <a href="tel:{{ inq.phone }}" class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center hover:bg-green-600 hover:text-white transition-colors">
                                            <i class="ph-bold ph-phone text-green-700 text-xs"></i>
                                        </a>
                                        {% if inq.message %}
                                        <button title="{{ inq.message }}" class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center hover:bg-blue-600 hover:text-white transition-colors">
                                            <i class="ph-bold ph-chat-dots text-blue-700 text-xs"></i>
                                        </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="5" class="px-5 py-12 text-center text-muted">
                                <i class="ph-fill ph-users text-3xl block mb-2 text-slate-300"></i>
                                Koi lead nahi abhi
                            </td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ── PROFILE ────────────────────────────────────── -->
        <div x-show="activeTab==='profile'" x-transition>
            <div class="max-w-2xl">
                <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-8">
                    <div class="flex items-start gap-5 mb-8">
                        <div class="w-20 h-20 rounded-2xl bg-orange flex items-center justify-center font-outfit font-bold text-white text-4xl">
                            {{ request.user.full_name[0] }}
                        </div>
                        <div>
                            <h2 class="font-outfit text-2xl font-bold text-navy">{{ request.user.full_name }}</h2>
                            <div class="flex items-center gap-2 mt-1 flex-wrap">
                                <span class="text-xs bg-green-100 text-green-700 font-semibold px-2.5 py-1 rounded-full">RERA Broker</span>
                                <span class="text-xs bg-orange/10 text-orange font-semibold px-2.5 py-1 rounded-full">PropSurat.com</span>
                            </div>
                            <div class="text-sm text-muted mt-2">{{ request.user.email }}</div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Full Name</label>
                            <input type="text" value="{{ request.user.full_name }}" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-orange" readonly>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">RERA Number</label>
                            <input type="text" value="{{ request.user.profile.rera_number if request.user.profile.rera_number else 'Not Added' }}" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm font-mono focus:outline-none focus:border-orange" readonly>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Phone</label>
                            <input type="tel" value="{{ request.user.phone }}" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-orange" readonly>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Email</label>
                            <input type="email" value="{{ request.user.email }}" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-orange" readonly>
                        </div>
                    </div>
                    <div class="mt-6 pt-6 border-t border-slate-100">
                        <a href="#" class="btn btn-orange"><i class="ph-bold ph-pencil"></i> Edit Profile</a>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /p-6 -->
</div><!-- /main -->

<!-- Add Listing Modal -->
<div x-show="showAddModal" x-transition.opacity class="modal-overlay" @click.self="showAddModal=false" x-cloak>
    <div class="modal p-6 sm:p-8" style="max-width:720px">
        <div class="flex items-center justify-between mb-6">
            <h2 class="font-outfit text-2xl font-bold text-navy">New Listing</h2>
            <button @click="showAddModal=false" class="w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center">
                <i class="ph-bold ph-x text-slate-500"></i>
            </button>
        </div>
        {% if not can_add_listing %}
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
            <i class="ph-fill ph-lock text-amber-500 text-3xl block mb-3"></i>
            <h3 class="font-outfit font-bold text-navy mb-1">Listing Limit Reached</h3>
            <p class="text-muted text-sm mb-4">
                Aapke {{ active_plan.display_name if active_plan else 'Free' }} plan mein max
                <strong>{{ listing_limit }}</strong> listings allowed hain.
                Upgrade karo aur unlimited listings add karo!
            </p>
            <a href="{{ url('billing_plans') }}" class="btn btn-orange w-full justify-center mb-2">
                <i class="ph-bold ph-crown"></i> Upgrade Plan
            </a>
            <button @click="showAddModal=false" class="w-full text-center text-sm text-muted hover:text-navy py-2">Cancel</button>
        </div>
        {% else %}
        <div id="listing-form-container"
             hx-get="{{ url('add_property') }}"
             hx-trigger="intersect once"
             hx-swap="innerHTML">
