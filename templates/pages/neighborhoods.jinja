                </div>
                <button class="bg-orange hover:bg-orange-700 text-white px-8 rounded-full font-bold transition-colors">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Interactive Map Placeholder -->
    <section class="py-12 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
