{% if recent_logs %}
{% for log in recent_logs %}
<div class="flex items-start gap-3 py-3 border-b border-slate-100 last:border-0">
    <div class="w-7 h-7 rounded-lg flex-shrink-0 flex items-center justify-center mt-0.5
        {% if 'ban' in log.action %}bg-red-100{% elif 'impersonate' in log.action %}bg-purple-100{% elif 'approve' in log.action or 'verify' in log.action or 'reinstate' in log.action %}bg-green-100{% elif 'reject' in log.action or 'suspend' in log.action %}bg-red-100{% else %}bg-slate-100{% endif %}">
        <i class="ph-bold text-xs
            {% if 'ban' in log.action %}ph-user-minus text-red-600{% elif 'impersonate' in log.action %}ph-user-switch text-purple-600{% elif 'approve' in log.action or 'verify' in log.action or 'reinstate' in log.action %}ph-check text-green-600{% elif 'reject' in log.action or 'suspend' in log.action %}ph-x text-red-600{% else %}ph-activity text-slate-500{% endif %}">
        </i>
    </div>
    <div class="flex-1 min-w-0">
        <div class="text-sm text-navy font-medium">
            {{ log.get_action_display() }}
            {% if log.target_user %}
            → <span class="text-orange">{{ log.target_user.full_name }}</span>
            {% endif %}
        </div>
        <div class="text-xs text-muted mt-0.5">
            by {{ log.admin.full_name if log.admin else 'System' }} ·
            {{ log.created_at.strftime('%d %b %Y, %I:%M %p') }}
        </div>
    </div>
</div>
{% endfor %}
{% else %}
<div class="py-8 text-center text-muted text-sm">
    <i class="ph-bold ph-activity text-2xl mb-2 block"></i>
    No activity yet
</div>
{% endif %}
