                        </a>

                        <a href="#" class="block group">
                            <div class="relative h-32 rounded-lg overflow-hidden mb-3">
                                <img src="https://images.unsplash.com/photo-1542204165-65bf26472b9b?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80"
                                    alt="News"
                                    class="w-full h-full object-cover transform group-hover:scale-105 transition-duration-500">
                                <div class="absolute inset-0 bg-slate-900/10 group-hover:bg-transparent transition-colors">
                                </div>
                            </div>
                            <h4
                                class="text-slate-900 font-medium text-sm leading-snug group-hover:text-orange transition-colors mb-1 line-clamp-2">
                                Why Bandra Remains Mumbai's Most Sought-After Locality</h4>
                            <span class="text-slate-400 text-xs">Oct 18, 2025</span>
                        </a>
                    </div>

                    <a href="{{ url('blog') }}"
                        class="block w-full text-center py-3 mt-6 rounded-lg bg-slate-100 hover:bg-slate-100 border border-slate-200 text-slate-900 font-medium transition-colors text-sm">
                        View All News
                    </a>
                </div>
            </aside>

        </div>
    </main>

{% endblock %}
