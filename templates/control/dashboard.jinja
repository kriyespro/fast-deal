{% extends 'control/base_control.jinja' %}

{% block title %}Dashboard | Mission Control{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block content %}

<!-- Live stats — auto-refresh every 30s -->
<div hx-get="{{ url('control:stats_card') }}"
     hx-trigger="every 30s"
     hx-swap="outerHTML"
     class="mb-8">
    {% include 'control/partials/_stats_card.jinja' %}
</div>

<!-- Secondary stats row -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="mc-stat">
        <div class="w-9 h-9 bg-blue-50 rounded-xl flex items-center justify-center mb-3">
            <i class="ph-fill ph-user text-blue-600 text-base"></i>
        </div>
        <div class="font-outfit text-2xl font-bold text-navy">{{ stats.total_clients }}</div>
        <div class="text-muted text-sm mt-1">Clients</div>
    </div>
    <div class="mc-stat">
        <div class="w-9 h-9 bg-purple-50 rounded-xl flex items-center justify-center mb-3">
            <i class="ph-fill ph-crane-tower text-purple-600 text-base"></i>
        </div>
        <div class="font-outfit text-2xl font-bold text-navy">{{ stats.total_builders }}</div>
        <div class="text-muted text-sm mt-1">Builders</div>
    </div>
    <div class="mc-stat">
        <div class="w-9 h-9 bg-amber-50 rounded-xl flex items-center justify-center mb-3">
            <i class="ph-fill ph-clock text-amber-500 text-base"></i>
        </div>
        <div class="font-outfit text-2xl font-bold text-navy">{{ stats.pending_properties }}</div>
        <div class="text-muted text-sm mt-1">Pending Listings</div>
    </div>
    <div class="mc-stat">
        <div class="w-9 h-9 bg-orange/10 rounded-xl flex items-center justify-center mb-3">
            <i class="ph-fill ph-buildings text-orange text-base"></i>
        </div>
        <div class="font-outfit text-2xl font-bold text-navy">{{ stats.total_properties }}</div>
        <div class="text-muted text-sm mt-1">Total Listings</div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Recent signups -->
    <div class="lg:col-span-1 mc-card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-outfit font-semibold text-navy">Recent Signups</h3>
            <a href="{{ url('control:users') }}" class="text-orange text-sm font-medium hover:underline">View all →</a>
        </div>
        <div class="space-y-3">
            {% for user in recent_users %}
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-navy/10 flex items-center justify-center font-outfit font-bold text-navy text-sm flex-shrink-0">
                    {{ user.full_name[0] }}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="font-medium text-navy text-sm truncate">{{ user.full_name }}</div>
                    <div class="text-xs text-muted">{{ user.get_role_display() }} · {{ user.date_joined.strftime('%d %b') }}</div>
                </div>
                <span class="badge text-xs
                    {% if user.role == 'broker' %}bg-blue-100 text-blue-700
                    {% elif user.role == 'builder' %}bg-purple-100 text-purple-700
                    {% else %}bg-slate-100 text-slate-600{% endif %}">
                    {{ user.get_role_display() }}
                </span>
            </div>
            {% else %}
            <p class="text-sm text-muted">No users yet.</p>
            {% endfor %}
        </div>
    </div>

    <!-- Activity feed — auto-refresh every 30s -->
    <div class="lg:col-span-2 mc-card">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-outfit font-semibold text-navy">Activity Log</h3>
            <span class="text-xs text-muted flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full inline-block animate-pulse"></span>
                Live · updates every 30s
            </span>
        </div>
        <div hx-get="{{ url('control:activity_feed') }}"
             hx-trigger="every 30s"
             hx-swap="innerHTML">
            {% include 'control/partials/_activity_feed.jinja' %}
        </div>
    </div>
</div>

{% endblock %}
