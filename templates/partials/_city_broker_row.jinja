<tr id="broker-row-{{ broker.pk }}" class="hover:bg-slate-50 transition-colors">
    <td class="px-5 py-4">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-navy/10 flex items-center justify-center font-outfit font-bold text-navy text-sm flex-shrink-0">
                {{ broker.full_name[0] }}
            </div>
            <div>
                <div class="font-medium text-navy">{{ broker.full_name }}</div>
                <div class="text-xs text-muted">{{ broker.email }}</div>
            </div>
        </div>
    </td>
    <td class="px-5 py-4 text-muted text-sm hidden md:table-cell">
        {{ broker.profile.city if broker.profile.city else '—' }}
    </td>
    <td class="px-5 py-4 hidden lg:table-cell">
        {% if broker.profile.rera_number %}
        <span class="text-xs font-mono text-slate-600">{{ broker.profile.rera_number[:25] }}...</span>
        {% else %}
        <span class="text-xs text-amber-600">Not submitted</span>
        {% endif %}
    </td>
    <td class="px-5 py-4 text-center text-navy font-medium hidden xl:table-cell">
        {{ broker.city_listing_count }}
    </td>
    <td class="px-5 py-4">
        {% if not broker.is_active %}
        <span class="badge bg-red-100 text-red-600">Suspended</span>
        {% elif broker.is_verified %}
        <span class="badge bg-green-100 text-green-700">Active</span>
        {% else %}
        <span class="badge bg-amber-100 text-amber-700">Pending</span>
        {% endif %}
    </td>
    <td class="px-5 py-4">
        <div class="flex gap-1.5">
            {% if not broker.is_active %}
            <button hx-post="{{ url('reinstate_broker', pk=broker.pk) }}"
                    hx-target="#broker-row-{{ broker.pk }}"
                    hx-swap="outerHTML"
                    class="btn btn-outline text-xs py-1 px-2">Reinstate</button>
            {% elif not broker.is_verified %}
            <button hx-post="{{ url('verify_broker', pk=broker.pk) }}"
                    hx-target="#broker-row-{{ broker.pk }}"
                    hx-swap="outerHTML"
                    class="btn btn-green text-xs py-1 px-2">Verify</button>
            {% else %}
            <button hx-post="{{ url('suspend_broker', pk=broker.pk) }}"
                    hx-target="#broker-row-{{ broker.pk }}"
                    hx-swap="outerHTML"
                    class="btn btn-red text-xs py-1 px-2">Suspend</button>
            {% endif %}
            <button class="btn btn-outline text-xs py-1 px-2">
                <i class="ph-bold ph-eye text-xs"></i>
            </button>
        </div>
    </td>
</tr>
