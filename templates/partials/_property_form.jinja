<form hx-post="{{ url('add_property') }}"
      hx-target="#listing-form-container"
      hx-swap="innerHTML"
      hx-encoding="multipart/form-data"
      enctype="multipart/form-data"
      class="space-y-4"
      x-data="{ preview: [] }"
      @change="if ($event.target.files) { preview = Array.from($event.target.files).map(f => ({name: f.name, url: URL.createObjectURL(f)})) }">
    {{ csrf_input }}

    {% if form.non_field_errors %}
    <div class="p-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
        {{ form.non_field_errors[0] }}
    </div>
    {% endif %}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.title.label }}</label>
            {{ form.title }}
            {% if form.title.errors %}<p class="text-red-500 text-xs mt-1">{{ form.title.errors.0 }}</p>{% endif %}
        </div>
        <div>
            <label class="form-label">{{ form.property_type.label }}</label>
            {{ form.property_type }}
        </div>
        <div>
            <label class="form-label">{{ form.listing_type.label }}</label>
            {{ form.listing_type }}
        </div>
        <div>
            <label class="form-label">{{ form.city.label }}</label>
            {{ form.city }}
            {% if form.city.errors %}<p class="text-red-500 text-xs mt-1">{{ form.city.errors.0 }}</p>{% endif %}
        </div>
        <div>
            <label class="form-label">{{ form.locality.label }}</label>
            {{ form.locality }}
        </div>
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.address.label }}</label>
            {{ form.address }}
        </div>
        <div>
            <label class="form-label">{{ form.price.label }}</label>
            {{ form.price }}
            {% if form.price.errors %}<p class="text-red-500 text-xs mt-1">{{ form.price.errors.0 }}</p>{% endif %}
        </div>
        <div>
            <label class="form-label">{{ form.area_sqft.label }}</label>
            {{ form.area_sqft }}
        </div>
        <div>
            <label class="form-label">{{ form.bedrooms.label }}</label>
            {{ form.bedrooms }}
        </div>
        <div>
            <label class="form-label">{{ form.bathrooms.label }}</label>
            {{ form.bathrooms }}
        </div>
        <div>
            <label class="form-label">{{ form.furnishing.label }}</label>
            {{ form.furnishing }}
        </div>
        <div>
            <label class="form-label">{{ form.rera_id.label }}</label>
            {{ form.rera_id }}
        </div>
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.amenities.label }}</label>
            {{ form.amenities }}
        </div>
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.description.label }}</label>
            {{ form.description }}
        </div>

        <!-- Multi image upload -->
        <div class="sm:col-span-2">
            <label class="form-label">Photos (multiple — max 12)</label>
            <input type="file"
                   name="images"
                   accept="image/jpeg,image/png,image/webp"
                   multiple
                   required
                   class="block w-full text-sm text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-orange file:text-white file:font-semibold hover:file:bg-orange-600">
            <p class="text-xs text-muted mt-1.5">Pehli photo cover banegi. JPG/PNG/WebP, auto-compress.</p>
            <div class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-2" x-show="preview.length">
                <template x-for="(p, i) in preview" :key="i">
                    <div class="relative aspect-square rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
                        <img :src="p.url" class="w-full h-full object-cover" alt="">
                        <span class="absolute bottom-1 left-1 text-[10px] bg-navy/80 text-white px-1.5 py-0.5 rounded"
                              x-text="i === 0 ? 'Cover' : (i+1)"></span>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <div class="flex gap-3 pt-4 border-t border-slate-100">
        <button type="submit" class="btn btn-orange flex-1 justify-center">
            <i class="ph-bold ph-images"></i> Submit Listing + Photos
        </button>
    </div>
</form>
