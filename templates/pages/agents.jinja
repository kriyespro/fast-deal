{% extends 'base.jinja' %}

{% block title %}Verified Brokers | PropSurat{% endblock %}
{% block extra_head %}
<style>
}

        .agent-card:hover .agent-img {
            transform: scale(1.05);
        }

        .agent-card:hover .social-links {
            opacity: 1;
            transform: translateY(0);
        }
</style>
{% endblock %}


{% block content %}
    <!-- Page Header -->
    <div class="pt-16 pb-12 bg-white border-b border-slate-200 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5">
        </div>
        <div
            class="absolute top-1/2 left-0 w-64 h-64 bg-navy/10 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 pointer-events-none">
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <span
                class="inline-block py-1 px-3 rounded-full bg-orange/10 text-orange border border-orange/30 text-sm font-medium tracking-wider mb-4 uppercase">
                Verified Brokers
            </span>
            <h1 class="text-4xl md:text-5xl font-bold text-slate-900 font-outfit mb-6">Hamara Verified <span class="text-gradient">Broker Network</span></h1>
            <p class="text-lg text-slate-500 max-w-2xl mx-auto mb-10">
                India ke sabse trusted verified brokers. RERA certified experts, aapki city ke maahere — 5,000+ brokers ek jagah pe.
            </p>

            <!-- Search Agents -->
            <div class="max-w-3xl mx-auto flex flex-col sm:flex-row gap-4">
                <div class="flex-1 relative">
                    <i
                        class="ph ph-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-lg"></i>
                    <input type="text" placeholder="Name, city ya specialization se dhundho..."
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl py-4 pl-12 pr-4 text-slate-900 focus:outline-none focus:border-orange placeholder-gray-500 shadow-inner">
                </div>
                <div class="sm:w-48 relative">
                    <select
                        class="w-full bg-slate-50 border border-slate-200 rounded-xl py-4 px-4 text-slate-900 focus:outline-none focus:border-orange appearance-none shadow-inner cursor-pointer">
                        <option value="">All Localities (Surat)</option>
                        <option>Vesu</option><option>Adajan</option><option>Athwa</option>
                        <option>Piplod</option><option>Pal</option><option>City Light</option>
                        <option>Althan</option><option>Dumas</option><option>VIP Road</option>
                    </select>
                    <i
                        class="ph ph-caret-down absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none"></i>
                </div>
            </div>
        </div>
    </div>

