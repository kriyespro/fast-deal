{% extends 'control/base_control.jinja' %}

{% block title %}User Manager | Mission Control{% endblock %}
{% block page_title %}User Manager{% endblock %}

{% block content %}

<!-- Search + filter bar -->
<div class="mc-card mb-6">
    <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
            <i class="ph-bold ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-muted text-sm"></i>
            <input type="search"
                   name="q"
                   value="{{ q }}"
                   placeholder="Search by name or email..."
                   class="mc-input pl-9"
                   hx-get="{{ url('control:users') }}"
                   hx-target="#users-tbody"
                   hx-swap="innerHTML"
                   hx-trigger="keyup changed delay:300ms"
                   hx-include="[name='role']"
                   hx-indicator="#search-spinner">
            <span id="search-spinner" class="htmx-indicator absolute right-3 top-1/2 -translate-y-1/2">
                <i class="ph-bold ph-circle-notch text-orange animate-spin text-sm"></i>
            </span>
        </div>
        <select name="role"
                class="mc-input w-auto min-w-[160px]"
                hx-get="{{ url('control:users') }}"
                hx-target="#users-tbody"
                hx-swap="innerHTML"
                hx-trigger="change"
                hx-include="[name='q']">
            <option value="" {% if not selected_role %}selected{% endif %}>All Roles</option>
            <option value="client" {% if selected_role == 'client' %}selected{% endif %}>Clients</option>
            <option value="broker" {% if selected_role == 'broker' %}selected{% endif %}>Brokers</option>
            <option value="builder" {% if selected_role == 'builder' %}selected{% endif %}>Builders</option>
            <option value="city_admin" {% if selected_role == 'city_admin' %}selected{% endif %}>City Admins</option>
            <option value="global_admin" {% if selected_role == 'global_admin' %}selected{% endif %}>Global Admins</option>
        </select>
    </div>
</div>

<!-- Users table -->
<div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-sm min-w-[480px]">
        <thead>
            <tr class="border-b border-slate-100 bg-slate-50">
                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide">User</th>
                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide hidden md:table-cell">Role</th>
                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide hidden lg:table-cell">Joined</th>
                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide hidden xl:table-cell">Phone</th>
                <th class="text-left px-5 py-3.5 font-semibold text-slate-500 text-xs uppercase tracking-wide">Status</th>
                <th class="px-5 py-3.5">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="users-tbody">
            {% include 'control/partials/_user_row.jinja' %}
        </tbody>
    </table>
    </div>
    {% if not users %}
    <div class="px-5 py-12 text-center text-muted">
        <i class="ph-fill ph-users text-3xl mb-2 block"></i>
        No users found.
    </div>
    {% endif %}
</div>

{% endblock %}
