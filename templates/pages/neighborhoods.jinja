{% block content %}
    <!-- Hero Section -->
    <div class="relative pt-16 pb-16 md:pt-24 md:pb-20 flex items-center bg-slate-50">
        <!-- Background Image -->
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1514565131-fce0801e5785?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
                alt="Localities" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-white/90 bg-gradient-to-t from-slate-50 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">
            <h1 class="text-3xl sm:text-5xl md:text-7xl font-bold text-slate-900 leading-tight mb-6">
                Surat Ke Top <br /><span class="text-gradient">Localities</span>
            </h1>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10">
