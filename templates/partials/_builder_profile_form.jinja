<form hx-post="{{ url('builder_profile') }}"
      hx-target="#profile-result"
      hx-swap="innerHTML"
      class="space-y-5">
    {{ csrf_input }}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            <label class="form-label">Full Name</label>
            {{ form.full_name }}
            {% if form.full_name.errors %}<p class="text-red-500 text-xs mt-1">{{ form.full_name.errors.0 }}</p>{% endif %}
        </div>
        <div>
            <label class="form-label">Phone</label>
            {{ form.phone }}
        </div>
        <div>
            <label class="form-label">Company Name</label>
            {{ form.company_name }}
        </div>
        <div>
            <label class="form-label">RERA Number</label>
            {{ form.rera_number }}
        </div>
        <div class="sm:col-span-2">
            <label class="form-label">Website</label>
            {{ form.website }}
        </div>
        <div class="sm:col-span-2">
            <label class="form-label">About Company</label>
            {{ form.bio }}
        </div>
    </div>
    <div class="flex gap-3 pt-4 border-t border-slate-100">
        <button type="submit" class="btn btn-orange"><i class="ph-bold ph-floppy-disk"></i> Save Changes</button>
    </div>
</form>
