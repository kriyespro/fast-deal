                        <i class="ph-fill ph-house mr-1"></i> Buy
                    </button>
                    <button @click="activeTab='rent'" :class="activeTab==='rent' ? 'border-orange text-orange bg-orange/5' : 'border-transparent text-slate-500 hover:text-slate-700'"
                        class="flex-1 sm:flex-none px-5 py-3 text-sm font-semibold border-b-2 transition-all">
                        <i class="ph-fill ph-key mr-1"></i> Rent
                    </button>
                    <button @click="activeTab='new'" :class="activeTab==='new' ? 'border-orange text-orange bg-orange/5' : 'border-transparent text-slate-500 hover:text-slate-700'"
                        class="flex-1 sm:flex-none px-5 py-3 text-sm font-semibold border-b-2 transition-all">
                        <i class="ph-fill ph-buildings mr-1"></i> New Projects
                    </button>
                    <button @click="activeTab='pg'" :class="activeTab==='pg' ? 'border-orange text-orange bg-orange/5' : 'border-transparent text-slate-500 hover:text-slate-700'"
                        class="hidden sm:block flex-none px-5 py-3 text-sm font-semibold border-b-2 transition-all">
                        <i class="ph-fill ph-bed mr-1"></i> PG / Co-living
                    </button>
                </div>
                <!-- Search Inputs -->
                <div class="p-3 sm:p-4">
                    <div class="flex flex-col sm:flex-row gap-2">
                        <div class="flex-1 relative">
                            <i class="ph ph-map-pin absolute left-3.5 top-1/2 -translate-y-1/2 text-orange text-lg"></i>
                            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-10 pr-4 text-sm text-slate-800 focus:outline-none focus:border-orange cursor-pointer appearance-none">
                                <option value="">📍 Select Locality (Surat)</option>
                                <option>Vesu</option><option>Adajan</option><option>Athwa</option>
                                <option>Piplod</option><option>Pal</option><option>City Light</option>
                                <option>Althan</option><option>Katargam</option><option>Varachha</option>
                                <option>Dumas</option><option>VIP Road</option><option>Palanpur</option>
                            </select>
                        </div>
                        <div class="flex-1 relative">
                            <i class="ph ph-buildings absolute left-3.5 top-1/2 -translate-y-1/2 text-orange text-lg"></i>
                            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-10 pr-4 text-sm text-slate-800 focus:outline-none focus:border-orange cursor-pointer appearance-none">
                                <option value="">🏠 Property Type</option>
                                <option>Flat / Apartment</option><option>Independent House/Villa</option>
                                <option>Plot / Land</option><option>Commercial Office</option>
                                <option>Commercial Shop</option><option>PG / Hostel</option>
                            </select>
                        </div>
                        <div class="flex-1 relative">
                            <i class="ph ph-currency-inr absolute left-3.5 top-1/2 -translate-y-1/2 text-orange text-lg"></i>
                            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3.5 pl-10 pr-4 text-sm text-slate-800 focus:outline-none focus:border-orange cursor-pointer appearance-none">
                                <option value="">💰 Budget</option>
                                <option>Under ₹25 Lakh</option><option>₹25L – ₹50L</option>
                                <option>₹50L – ₹1 Crore</option><option>₹1Cr – ₹2Cr</option>
                                <option>₹2Cr – ₹5Cr</option><option>Above ₹5 Crore</option>
                            </select>
                        </div>
                        <a href="{{ url('listings') }}" class="btn-primary flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-bold text-sm whitespace-nowrap">
                            <i class="ph-bold ph-magnifying-glass text-lg"></i>
                            <span>Search</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Quick Searches -->
            <div class="flex flex-wrap gap-2 mt-4">
                <span class="text-white/60 text-xs font-medium py-1">Popular:</span>
                <a href="{{ url('listings') }}?q=Vesu" class="text-xs bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-full backdrop-blur-sm transition-colors border border-white/20">2 BHK in Vesu</a>
                <a href="{{ url('listings') }}?q=Adajan" class="text-xs bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-full backdrop-blur-sm transition-colors border border-white/20">Flats in Adajan</a>
                <a href="{{ url('listings') }}?q=Piplod" class="text-xs bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-full backdrop-blur-sm transition-colors border border-white/20">Homes in Piplod</a>
                <a href="{{ url('listings') }}?q=Athwa" class="text-xs bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-full backdrop-blur-sm transition-colors border border-white/20">Rent in Athwa</a>
            </div>
        </div>
    </div>

    <!-- Floating stats -->
    <div class="hidden sm:block absolute bottom-6 right-6 z-10">
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 flex flex-col gap-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-orange/20 rounded-lg flex items-center justify-center">
                    <i class="ph-fill ph-buildings text-orange text-lg"></i>
                </div>
                <div><div class="text-white font-outfit font-bold text-lg leading-none">5,000+</div><div class="text-white/60 text-xs">Surat Properties</div></div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-orange/20 rounded-lg flex items-center justify-center">
                    <i class="ph-fill ph-users text-orange text-lg"></i>
                </div>
                <div><div class="text-white font-outfit font-bold text-lg leading-none">500+</div><div class="text-white/60 text-xs">Surat Brokers</div></div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-orange/20 rounded-lg flex items-center justify-center">
                    <i class="ph-fill ph-map-pin text-orange text-lg"></i>
                </div>
                <div><div class="text-white font-outfit font-bold text-lg leading-none">30+ Areas</div><div class="text-white/60 text-xs">Surat Coverage</div></div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ STATS TICKER ═══════════════ -->
<div class="bg-navy py-3 overflow-hidden">
    <div class="ticker-wrap">
        <div class="ticker-content text-white/80 text-sm font-medium">
            &nbsp;🏠 Surat Verified Properties &nbsp;•&nbsp; 📍 Vesu · Adajan · Athwa · Piplod · Pal &nbsp;•&nbsp; 👔 Local Brokers &nbsp;•&nbsp;
            🏗️ Surat Builders &nbsp;•&nbsp; ✅ RERA Certified Listings &nbsp;•&nbsp; 💰 Zero Brokerage Options &nbsp;•&nbsp;
            📱 Virtual Tour Available &nbsp;•&nbsp; 👨‍👩‍👧 Happy Surat Families &nbsp;•&nbsp; ⭐ 4.8/5 App Rating &nbsp;•&nbsp;
            &nbsp;🏠 Surat Verified Properties &nbsp;•&nbsp; 📍 Vesu · Adajan · Athwa · Piplod · Pal &nbsp;•&nbsp; 👔 Local Brokers &nbsp;•&nbsp;
            🏗️ Surat Builders &nbsp;•&nbsp; ✅ RERA Certified Listings &nbsp;•&nbsp; 💰 Zero Brokerage Options &nbsp;•&nbsp;
            📱 Virtual Tour Available &nbsp;•&nbsp; 👨‍👩‍👧 Happy Surat Families &nbsp;•&nbsp; ⭐ 4.8/5 App Rating &nbsp;•&nbsp;
        </div>
    </div>
</div>

<!-- ═══════════════ FEATURED PROPERTIES ═══════════════ -->
<section class="py-20 bg-cream" x-data="{ propTab: 'all' }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
            <div>
                <div class="text-orange text-sm font-bold uppercase tracking-widest mb-2">Trending Now</div>
                <h2 class="font-outfit text-3xl md:text-4xl font-800 text-navy">Featured Properties</h2>
                <p class="text-muted mt-2">Sahi Jagah Pe, Sahi Daam Mein — RERA verified listings</p>
            </div>
            <a href="{{ url('listings') }}" class="inline-flex items-center gap-2 text-orange font-semibold hover:gap-3 transition-all text-sm">
                Sabhi Properties Dekho <i class="ph ph-arrow-right"></i>
            </a>
        </div>

        <!-- Filter tabs -->
        <div class="flex flex-wrap gap-2 mb-8">
            <button @click="propTab='all'" :class="propTab==='all' ? 'bg-navy text-white' : 'bg-white text-slate-600 hover:text-navy border border-slate-200 hover:border-navy'" class="px-5 py-2 rounded-full text-sm font-semibold transition-all">All Types</button>
            <button @click="propTab='flat'" :class="propTab==='flat' ? 'bg-navy text-white' : 'bg-white text-slate-600 hover:text-navy border border-slate-200 hover:border-navy'" class="px-5 py-2 rounded-full text-sm font-semibold transition-all">🏢 Flats</button>
            <button @click="propTab='villa'" :class="propTab==='villa' ? 'bg-navy text-white' : 'bg-white text-slate-600 hover:text-navy border border-slate-200 hover:border-navy'" class="px-5 py-2 rounded-full text-sm font-semibold transition-all">🏡 Villas</button>
            <button @click="propTab='plot'" :class="propTab==='plot' ? 'bg-navy text-white' : 'bg-white text-slate-600 hover:text-navy border border-slate-200 hover:border-navy'" class="px-5 py-2 rounded-full text-sm font-semibold transition-all">🌿 Plots</button>
            <button @click="propTab='commercial'" :class="propTab==='commercial' ? 'bg-navy text-white' : 'bg-white text-slate-600 hover:text-navy border border-slate-200 hover:border-navy'" class="px-5 py-2 rounded-full text-sm font-semibold transition-all">🏪 Commercial</button>
        </div>

        <!-- Property Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            {% for prop in featured_properties %}
            {% set images = prop.prefetched_images if prop.prefetched_images is defined else (prop.images.all() | list) %}
            {% set thumb = images[0].image.url if images else 'https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=800&q=80' %}
            <div class="bg-white rounded-2xl overflow-hidden shadow-md card-hover border border-slate-100">
                <div class="relative h-56 overflow-hidden">
                    <a href="{{ url('property_detail', slug=prop.slug) }}" class="block w-full h-full">
                    <img src="{{ thumb }}" alt="{{ prop.title }}" loading="lazy" decoding="async"
                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=800&q=80'"
                         class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    </a>
                    <div class="absolute top-3 left-3 flex gap-2">
                        <span class="{% if prop.listing_type == 'sale' %}prop-tag-sale{% elif prop.listing_type == 'rent' %}prop-tag-rent{% else %}prop-tag-new{% endif %} text-xs font-bold px-2.5 py-1 rounded-full">
                            {{ prop.get_listing_type_display() }}
                        </span>
                        {% if prop.is_rera_verified %}
                        <span class="rera-badge text-white text-xs font-bold px-2.5 py-1 rounded-full">✓ RERA</span>
                        {% endif %}
                    </div>
                    {% if images %}
                    <div class="absolute bottom-3 left-3 bg-navy/90 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-full font-medium">
                        <i class="ph ph-camera mr-1"></i>{{ images | length }} Photos
                    </div>
                    {% endif %}
                    <div class="absolute bottom-3 right-3 bg-orange text-white text-sm font-bold px-3 py-1 rounded-full">
                        {{ prop.price_display }}
                    </div>
                </div>
                <div class="p-4">
                    <div class="text-xs text-orange font-bold uppercase tracking-wider mb-1">{{ prop.get_property_type_display() }}</div>
                    <a href="{{ url('property_detail', slug=prop.slug) }}" class="font-outfit text-base font-700 text-navy hover:text-orange transition-colors leading-snug block">{{ prop.title | truncate(45, True) }}</a>
                    <p class="text-muted text-sm flex items-center gap-1 mt-1 mb-3">
                        <i class="ph ph-map-pin text-orange text-base"></i>
                        {% if prop.locality %}{{ prop.locality.name }}, {% endif %}{{ prop.city.name if prop.city else '' }}
                    </p>
                    <div class="flex items-center gap-4 py-3 border-t border-slate-100 text-slate-600 text-sm">
                        {% if prop.bedrooms %}<span class="flex items-center gap-1.5"><i class="ph ph-bed text-slate-400 text-base"></i> {{ prop.bedrooms }} BHK</span>{% endif %}
                        {% if prop.bathrooms %}<span class="flex items-center gap-1.5"><i class="ph ph-bathtub text-slate-400 text-base"></i> {{ prop.bathrooms }} Bath</span>{% endif %}
                        <span class="flex items-center gap-1.5"><i class="ph ph-square text-slate-400 text-base"></i> {{ prop.area_sqft | int }} sqft</span>
                    </div>
                    <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                        <span class="text-xs text-muted">{{ prop.broker.full_name if prop.broker else 'PropSurat' }}</span>
                        <a href="{{ url('property_detail', slug=prop.slug) }}" class="text-xs font-semibold text-orange hover:underline">View Details →</a>
                    </div>
                </div>
            </div>
            {% endfor %}

            <!-- Property Card 6 - CTA Card -->
            <div class="bg-navy rounded-2xl overflow-hidden shadow-md card-hover flex flex-col items-center justify-center p-8 text-center">
                <div class="w-16 h-16 bg-orange/20 rounded-2xl flex items-center justify-center mb-4">
                    <i class="ph-fill ph-buildings text-orange text-3xl"></i>
                </div>
                <h3 class="font-outfit text-xl font-700 text-white mb-2">Aur bhi Properties hain!</h3>
                <p class="text-white/60 text-sm mb-6">1,200+ properties available in your chosen city</p>
                <a href="{{ url('listings') }}" class="btn-primary px-6 py-3 rounded-xl font-bold text-sm w-full text-center">
                    Sabhi Dekho →
                </a>
                <a href="{{ url('listings') }}" class="mt-3 text-white/50 hover:text-white text-xs transition-colors">Filter by Budget, BHK & More</a>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ POPULAR LOCALITIES (SURAT) ═══════════════ -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <div class="text-orange text-sm font-bold uppercase tracking-widest mb-2">Surat Coverage</div>
            <h2 class="font-outfit text-3xl md:text-4xl font-800 text-navy mb-3">Popular Localities</h2>
            <p class="text-muted max-w-xl mx-auto">Surat ke har corner mein — PropSurat sirf aapke sheher ke liye</p>
        </div>

