<form hx-post="{{ url('save_property', pk=property_pk) }}"
      hx-target="this" hx-swap="outerHTML">
    {{ csrf_input }}
    <button type="submit"
            title="{{ 'Unsave' if is_saved else 'Save Property' }}"
            class="w-8 h-8 rounded-full flex items-center justify-center shadow-sm transition-all
                   {{ 'bg-red-100 hover:bg-red-200' if is_saved else 'bg-white/90 hover:bg-red-100' }}">
        <i class="{{ 'ph-fill ph-heart text-red-500' if is_saved else 'ph-bold ph-heart text-slate-400' }} text-sm"></i>
    </button>
</form>
