{% if added is defined and added %}
<div class="mb-3 p-3 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm">
    ✓ {{ added }} photo(s) add ho gayi.
</div>
{% endif %}
<div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
    {% for img in images %}
    <div class="relative aspect-square rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
        <img src="{{ img.image.url }}" alt="" loading="lazy" class="w-full h-full object-cover"
             onerror="this.src='https://picsum.photos/seed/{{ property.pk }}{{ loop.index }}/200/200'">
        {% if img.is_primary %}
        <span class="absolute bottom-1 left-1 text-[10px] bg-orange text-white px-1.5 py-0.5 rounded font-semibold">Cover</span>
        {% endif %}
    </div>
    {% else %}
    <p class="text-sm text-muted col-span-full">Abhi koi photo nahi.</p>
    {% endfor %}
</div>
<form hx-post="{{ url('add_property_images', pk=property.pk) }}"
      hx-target="#property-images-{{ property.pk }}"
      hx-swap="innerHTML"
      enctype="multipart/form-data"
      class="mt-3 flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
    {{ csrf_input }}
    <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required
           class="flex-1 text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-navy file:text-white">
    <button type="submit" class="btn btn-orange text-sm justify-center">
        <i class="ph-bold ph-plus"></i> Add Photos
    </button>
</form>
