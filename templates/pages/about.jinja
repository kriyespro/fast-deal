{% extends 'base.jinja' %}

{% block title %}About Us | PropSurat — India's Property Portal{% endblock %}
{% block extra_head %}
<style>
.image-overlay-right {
    background: linear-gradient(to right, rgba(248,250,252,1) 0%, rgba(248,250,252,0.85) 30%, rgba(248,250,252,0.2) 60%, rgba(248,250,252,0) 100%);
}
.team-card:hover .team-img { transform: scale(1.08); }
.team-img { transition: transform 0.5s ease; }
</style>
{% endblock %}

{% block content %}

<!-- ───── HERO ───── -->
<div class="relative min-h-[500px] md:min-h-[600px] flex items-center bg-slate-50 overflow-hidden py-20 md:py-28">

    <!-- Desktop: right-half background image (FIXED: top-0 right-0 bottom-0, no inset-0) -->
    <div class="absolute top-0 right-0 bottom-0 w-1/2 z-0 hidden md:block">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1200&q=85&fit=crop&auto=format"
             alt="PropSurat Team" class="w-full h-full object-cover">
        <div class="absolute inset-0 image-overlay-right"></div>
    </div>

    <!-- Mobile: subtle full background -->
    <div class="absolute inset-0 z-0 md:hidden">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=800&q=70&fit=crop&auto=format"
             alt="" class="w-full h-full object-cover opacity-10">
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="w-full md:w-3/5 lg:w-1/2 text-center md:text-left">
            <span class="inline-block py-1 px-4 rounded-full bg-orange/10 text-orange border border-orange/30 text-sm font-semibold tracking-wider mb-6 uppercase">
                Our Story
            </span>
            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 leading-tight mb-6 font-outfit">
                India Ka Sabse<br>
                <span class="text-gradient">Trusted Property Portal</span>
            </h1>
            <p class="text-lg sm:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl">
                Integrity, transparency aur technology ke saath — PropSurat India ka sabse trusted multi-broker property portal hai. 50,000+ verified listings, 5,000+ RERA certified brokers, 50+ cities.
            </p>
            <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                <a href="{{ url('agents') }}"
                   class="bg-orange hover:bg-orange-600 text-white px-8 py-3.5 rounded-full font-bold transition-all shadow-lg shadow-orange/20 flex items-center gap-2">
                    <i class="ph ph-users text-lg"></i>
                    Hamare Brokers Dekho
                </a>
                <a href="{{ url('listings') }}"
                   class="bg-white hover:bg-slate-50 text-navy border border-slate-200 px-8 py-3.5 rounded-full font-bold transition-all shadow-sm flex items-center gap-2">
                    <i class="ph ph-buildings text-lg"></i>
                    Properties Dekho
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ───── STATS ───── -->
<section class="border-y border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 divide-x divide-slate-100 border-x border-slate-100">

            <div class="p-8 md:p-12 text-center hover:bg-orange/[0.02] transition-colors">
                <div class="text-3xl md:text-5xl font-bold text-orange mb-2 font-outfit">₹10,000 Cr+</div>
                <div class="text-xs md:text-sm text-slate-500 font-semibold uppercase tracking-widest">Total Transactions</div>
            </div>
            <div class="p-8 md:p-12 text-center hover:bg-orange/[0.02] transition-colors">
                <div class="text-3xl md:text-5xl font-bold text-orange mb-2 font-outfit">50+</div>
                <div class="text-xs md:text-sm text-slate-500 font-semibold uppercase tracking-widest">Cities Covered</div>
            </div>
            <div class="p-8 md:p-12 text-center hover:bg-orange/[0.02] transition-colors border-t md:border-t-0">
                <div class="text-3xl md:text-5xl font-bold text-orange mb-2 font-outfit">5,000+</div>
                <div class="text-xs md:text-sm text-slate-500 font-semibold uppercase tracking-widest">Verified Brokers</div>
            </div>
            <div class="p-8 md:p-12 text-center hover:bg-orange/[0.02] transition-colors border-t md:border-t-0">
                <div class="text-3xl md:text-5xl font-bold text-orange mb-2 font-outfit">10L+</div>
                <div class="text-xs md:text-sm text-slate-500 font-semibold uppercase tracking-widest">Happy Families</div>
            </div>

        </div>
    </div>
</section>

<!-- ───── MISSION & VALUES ───── -->
<section class="py-20 md:py-28 bg-slate-50 relative overflow-hidden">
    <div class="absolute top-1/2 left-0 w-80 h-80 bg-navy/5 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16 items-center">

            <!-- Image Grid (fixed heights to prevent overflow issues) -->
            <div class="w-full lg:w-1/2 shrink-0">
                <div class="grid grid-cols-2 gap-4 h-[420px] md:h-[480px]">
                    <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xl row-span-1 mt-8">
                        <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=600&q=80&fit=crop&auto=format"
                             alt="Beautiful Home" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
                    </div>
                    <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-xl row-span-1 -mt-4">
                        <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=600&q=80&fit=crop&auto=format"
                             alt="Modern Interior" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="w-full lg:w-1/2">
                <span class="inline-block py-1 px-4 rounded-full bg-orange/10 text-orange border border-orange/30 text-sm font-semibold tracking-wider mb-6 uppercase">
                    Our Mission
                </span>
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 font-outfit mb-6">Hamara Mission</h2>
                <p class="text-slate-500 text-lg mb-12 leading-relaxed">
                    Technology, transparency aur trusted brokers ko ek platform pe laana — yahi hamara mission hai. Har Indian family ko uska sapna ghar milna chahiye, bina fraud ke, bina tension ke.
                </p>

                <div class="space-y-7">
                    <div class="flex gap-4 items-start">
                        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-navy text-orange flex items-center justify-center shadow-sm">
                            <i class="ph-fill ph-handshake text-2xl"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-slate-900 mb-1.5">Poori Imaandaari</h4>
                            <p class="text-slate-500 text-sm leading-relaxed">Har transaction mein poori transparency. RERA verified listings, verified brokers — koi hidden charges nahi.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-orange text-white flex items-center justify-center shadow-sm">
                            <i class="ph-fill ph-star text-2xl"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-slate-900 mb-1.5">Shreshtha Sewa</h4>
                            <p class="text-slate-500 text-sm leading-relaxed">Property photos se lekar final registration tak — har kadam pe best quality service. Kyunki aapka ghar aapki zindagi ka sabse bada decision hai.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 items-start">
                        <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-green-600 text-white flex items-center justify-center shadow-sm">
                            <i class="ph-fill ph-globe text-2xl"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-slate-900 mb-1.5">Pan India Reach</h4>
                            <p class="text-slate-500 text-sm leading-relaxed">Surat se shuru hokar Mumbai, Delhi, Bangalore, Hyderabad — 50+ cities mein PropSurat ka strong network. Local expertise, national reach.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ───── TEAM ───── -->
<section class="py-20 md:py-28 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <span class="inline-block py-1 px-4 rounded-full bg-orange/10 text-orange border border-orange/30 text-sm font-semibold tracking-wider mb-5 uppercase">
                Leadership
            </span>
            <h2 class="text-3xl md:text-5xl font-bold text-slate-900 font-outfit mb-5">Hamaari Team</h2>
            <p class="text-slate-500 max-w-xl mx-auto text-lg">PropSurat ke founders aur leaders — India ki real estate ko transparent aur digital banana ka sapna.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 max-w-4xl mx-auto">

            <div class="team-card text-center group">
                <div class="w-44 h-44 mx-auto rounded-full overflow-hidden border-4 border-slate-100 group-hover:border-orange/40 transition-colors shadow-xl mb-6">
                    <img src="https://images.unsplash.com/photo-1556157382-97eda2d62296?w=400&h=400&fit=crop&q=80&auto=format"
                         alt="Vikram Mehta" class="team-img w-full h-full object-cover object-top">
                </div>
                <h3 class="text-xl font-bold text-slate-900 font-outfit mb-1 group-hover:text-orange transition-colors">Vikram Mehta</h3>
                <p class="text-orange text-sm font-semibold mb-4">Founder & CEO</p>
                <div class="flex justify-center gap-3">
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-navy hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-linkedin-logo"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-orange hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-envelope-simple"></i>
                    </a>
                </div>
            </div>

            <div class="team-card text-center group">
                <div class="w-44 h-44 mx-auto rounded-full overflow-hidden border-4 border-slate-100 group-hover:border-orange/40 transition-colors shadow-xl mb-6">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&h=400&fit=crop&q=80&auto=format"
                         alt="Deepa Iyer" class="team-img w-full h-full object-cover object-top">
                </div>
                <h3 class="text-xl font-bold text-slate-900 font-outfit mb-1 group-hover:text-orange transition-colors">Deepa Iyer</h3>
                <p class="text-orange text-sm font-semibold mb-4">Chief Operating Officer</p>
                <div class="flex justify-center gap-3">
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-navy hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-linkedin-logo"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-orange hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-envelope-simple"></i>
                    </a>
                </div>
            </div>

            <div class="team-card text-center group">
                <div class="w-44 h-44 mx-auto rounded-full overflow-hidden border-4 border-slate-100 group-hover:border-orange/40 transition-colors shadow-xl mb-6">
                    <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&h=400&fit=crop&q=80&auto=format"
                         alt="Rahul Kapoor" class="team-img w-full h-full object-cover object-top">
                </div>
                <h3 class="text-xl font-bold text-slate-900 font-outfit mb-1 group-hover:text-orange transition-colors">Rahul Kapoor</h3>
                <p class="text-orange text-sm font-semibold mb-4">Chief Marketing Officer</p>
                <div class="flex justify-center gap-3">
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-navy hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-linkedin-logo"></i>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-orange hover:text-white transition-all flex items-center justify-center text-slate-500">
                        <i class="ph-fill ph-envelope-simple"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ───── INDIA NETWORK ───── -->
<section class="py-20 md:py-28 bg-navy relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background-image: url('https://www.transparenttextures.com/patterns/connected.png');"></div>
    <div class="absolute top-1/2 left-1/2 w-[600px] h-[300px] bg-orange/10 rounded-[100%] blur-3xl -translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <span class="inline-block py-1 px-4 rounded-full bg-orange/20 text-orange border border-orange/30 text-sm font-semibold tracking-wider mb-6 uppercase">
            Pan India
        </span>
        <h2 class="text-3xl md:text-5xl font-bold text-white font-outfit mb-6">Hamara India Network</h2>
        <p class="text-slate-300 text-lg max-w-2xl mx-auto mb-12 leading-relaxed">
            50+ cities, 5,000+ verified brokers, aur 10 lakh+ registered users ke saath, PropSurat India ke har kone tak pahunchta hai.
        </p>

        <div class="inline-flex flex-wrap items-center justify-center gap-0 bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl overflow-hidden">
            <div class="px-8 py-6 text-center border-r border-white/10">
                <div class="text-3xl font-bold text-white mb-1 font-outfit">50+</div>
                <div class="text-xs text-slate-300 font-semibold uppercase tracking-widest">Cities</div>
            </div>
            <div class="px-8 py-6 text-center border-r border-white/10">
                <div class="text-3xl font-bold text-white mb-1 font-outfit">5,000+</div>
                <div class="text-xs text-slate-300 font-semibold uppercase tracking-widest">Verified Brokers</div>
            </div>
            <div class="px-8 py-6 text-center border-r border-white/10">
                <div class="text-3xl font-bold text-white mb-1 font-outfit">10L+</div>
                <div class="text-xs text-slate-300 font-semibold uppercase tracking-widest">Registered Users</div>
            </div>
            <div class="px-8 py-6 text-center">
                <div class="text-3xl font-bold text-orange mb-1 font-outfit">₹10K Cr+</div>
                <div class="text-xs text-slate-300 font-semibold uppercase tracking-widest">Transactions</div>
            </div>
        </div>

        <div class="mt-12 flex flex-wrap justify-center gap-3 text-sm">
            {% set cities_list = ['Mumbai', 'Delhi', 'Bangalore', 'Hyderabad', 'Pune', 'Surat', 'Ahmedabad', 'Chennai', 'Kolkata', 'Jaipur', 'Lucknow', 'Indore'] %}
            {% for c in cities_list %}
            <span class="px-4 py-1.5 bg-white/10 text-slate-200 rounded-full border border-white/10 font-medium">{{ c }}</span>
            {% endfor %}
            <span class="px-4 py-1.5 bg-orange/20 text-orange rounded-full border border-orange/30 font-medium">+40 more cities</span>
        </div>
    </div>
</section>

<!-- ───── CTA ───── -->
<section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 font-outfit mb-4">Apna Sapna Ghar Dhundho</h2>
        <p class="text-slate-500 text-lg mb-8">50,000+ verified listings, RERA certified brokers — PropSurat pe shuru karein aaj hi.</p>
        <div class="flex flex-wrap gap-4 justify-center">
            <a href="{{ url('listings') }}" class="bg-orange hover:bg-orange-600 text-white px-10 py-4 rounded-full font-bold transition-all shadow-lg shadow-orange/20 text-lg">
                Properties Dekho
            </a>
            <a href="{{ url('contact') }}" class="bg-white hover:bg-slate-50 text-navy border-2 border-navy px-10 py-4 rounded-full font-bold transition-all text-lg">
                Contact Us
            </a>
        </div>
    </div>
</section>

{% endblock %}
