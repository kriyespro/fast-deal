<form hx-post="{{ url('add_project') }}"
      hx-target="#project-form-container"
      hx-swap="innerHTML"
      enctype="multipart/form-data"
      class="space-y-4">
    {{ csrf_input }}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Name -->
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.name.label }}</label>
            {{ form.name }}
            {% if form.name.errors %}<p class="text-red-500 text-xs mt-1">{{ form.name.errors.0 }}</p>{% endif %}
        </div>
        <!-- Type + Status -->
        <div>
            <label class="form-label">{{ form.project_type.label }}</label>
            {{ form.project_type }}
        </div>
        <div>
            <label class="form-label">{{ form.status.label }}</label>
            {{ form.status }}
        </div>
        <!-- City + Locality -->
        <div>
            <label class="form-label">{{ form.city.label }}</label>
            {{ form.city }}
        </div>
        <div>
            <label class="form-label">{{ form.locality.label }}</label>
            {{ form.locality }}
        </div>
        <!-- Address -->
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.address.label }}</label>
            {{ form.address }}
        </div>
        <!-- Price -->
        <div>
            <label class="form-label">{{ form.price_min.label }}</label>
            {{ form.price_min }}
            {% if form.price_min.errors %}<p class="text-red-500 text-xs mt-1">{{ form.price_min.errors.0 }}</p>{% endif %}
        </div>
        <div>
            <label class="form-label">{{ form.price_max.label }}</label>
            {{ form.price_max }}
        </div>
        <!-- Units + Completion -->
        <div>
            <label class="form-label">{{ form.total_units.label }}</label>
            {{ form.total_units }}
        </div>
        <div>
            <label class="form-label">{{ form.completion_pct.label }}</label>
            {{ form.completion_pct }}
        </div>
        <!-- RERA -->
        <div>
            <label class="form-label">{{ form.rera_id.label }}</label>
            {{ form.rera_id }}
        </div>
        <!-- Possession -->
        <div>
            <label class="form-label">{{ form.expected_possession.label }}</label>
            {{ form.expected_possession }}
        </div>
        <!-- Description -->
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.description.label }}</label>
            {{ form.description }}
        </div>
        <!-- Image -->
        <div class="sm:col-span-2">
            <label class="form-label">{{ form.image.label }}</label>
            {{ form.image }}
        </div>
    </div>
    <div class="flex gap-3 pt-4 border-t border-slate-100">
        <button type="submit" class="btn btn-orange flex-1 justify-center">
            <i class="ph-bold ph-paper-plane-tilt"></i> Submit for Review
        </button>
        <button type="button" @click="showAddProject=false" class="btn btn-outline">Cancel</button>
    </div>
</form>
